# CampusSphere CRM Environment Configuration Template
# Copy this file to .env locally and configure environment variables

ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=super-secret-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL / SQLite)
POSTGRES_USER=campussphere
POSTGRES_PASSWORD=campussphere_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campussphere_db

# Redis Cache & Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
