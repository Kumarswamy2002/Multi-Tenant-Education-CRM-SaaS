# CampusSphere CRM Environment Configuration

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=super-secret-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_USER=campussphere
POSTGRES_PASSWORD=campussphere_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campussphere_db
DATABASE_URL=postgresql+asyncpg://campussphere:campussphere_pass@localhost:5432/campussphere_db

# Redis Cache & Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Event Streaming (Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=campussphere-service

# OpenSearch Global Search
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http

# Storage (S3 / Local Object Storage)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=campussphere-docs
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Communication Service Providers
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=test_user
SMTP_PASSWORD=test_password
EMAIL_FROM=no-reply@campussphere.edu

# AI / ML Configuration
OPENAI_API_KEY=sk-demo-key-replace-with-valid
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
